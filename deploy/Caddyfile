# Two domains, both pointing to this server (DNS A/AAAA record).
# Caddy obtains the HTTPS certificates automatically.
# Without Docker replace "helmcam:5036" with "127.0.0.1:5036".

cam.example.com {
	reverse_proxy helmcam:5036 {
		flush_interval -1
	}
}

admin.example.com {
	reverse_proxy helmcam:5036 {
		flush_interval -1
	}
}
