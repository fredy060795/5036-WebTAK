# Zwei Domains, beide zeigen auf diesen Server (DNS A/AAAA-Eintrag).
# Caddy besorgt die HTTPS-Zertifikate automatisch.
# Ohne Docker "helmcam:8080" durch "127.0.0.1:8080" ersetzen.

cam.example.com {
	reverse_proxy helmcam:8080 {
		flush_interval -1
	}
}

admin.example.com {
	reverse_proxy helmcam:8080 {
		flush_interval -1
	}
}
