# systemd service without Docker, HTTPS directly on port 5036:
#   sudo cp deploy/helm-camera.service /etc/systemd/system/   (adjust the domain below)
#   sudo systemctl daemon-reload && sudo systemctl enable --now helm-camera
#
# The certificate is passed via LoadCredential (the service does not run as root).
# Restart after a renewal, e.g. in certbot:
#   certbot renew --deploy-hook "systemctl restart helm-camera"
[Unit]
Description=Helm Camera Streams
After=network-online.target
Wants=network-online.target

[Service]
User=helmcam
WorkingDirectory=/opt/helm-camera
Environment=PORT=5036
Environment=PUBLIC_URL=https://tak.example.com:5036
Environment=DATA_DIR=/var/lib/helm-camera
LoadCredential=cert:/etc/letsencrypt/live/tak.example.com/fullchain.pem
LoadCredential=key:/etc/letsencrypt/live/tak.example.com/privkey.pem
Environment=TLS_CERT=%d/cert
Environment=TLS_KEY=%d/key
# Behind a reverse proxy instead: remove the four lines above,
# set Environment=BIND=127.0.0.1 and change PUBLIC_URL to the proxy address.
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
StateDirectory=helm-camera
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/helm-camera

[Install]
WantedBy=multi-user.target
